{
    "name": "crud-api",
    "version": "1.0.0",
    "type": "module",
    "description": "RSSchool task CRUD API",
    "engines": {
        "node": ">=22.14.0"
    },
    "main": "index.js",
    "scripts": {
        "start:dev": "nodemon --watch ./ --ext ts --exec \"node --loader ts-node/esm\" index.ts",
        "build": "tsc",
        "start:prod": "npm run build && node dist/index.js",
        "test": "cross-env NODE_ENV=test jest",
        "start:multi": "nodemon --watch ./ --ext ts --exec \"node --loader ts-node/esm\" cluster.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ArturKhelshtein/CRUD-API.git"
    },
    "keywords": [
        "nodejs",
        "assignments",
        "ArturKhelshtein"
    ],
    "author": "ArturKhelshtein",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/ArturKhelshtein/CRUD-API/issues"
    },
    "homepage": "https://github.com/ArturKhelshtein/CRUD-API#readme",
    "dependencies": {
        "dotenv": "^16.5.0",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@types/jest": "^29.5.14",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "@typescript-eslint/parser": "^8.32.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.5",
        "jest": "^29.7.0",
        "nodemon": "^3.1.10",
        "supertest": "^7.1.0",
        "ts-jest": "^29.3.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}
